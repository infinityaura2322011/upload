{
	"name": "coding-monster",
	"version": "0.2.0",
	"private": true,
	"description": "Coding Monster — autonomous AI engineering command center",
	"main": "dist/server.js",
	"scripts": {
		"dev": "node dist/server.js",
		"build": "node --check dist/server.js",
		"lint": "node --check dist/server.js",
		"start": "node dist/server.js"
	},
	"dependencies": {
		"dotenv": "^16.4.5",
		"express": "^4.19.2",
		"msedge-tts": "^2.1.1",
		"sql.js": "^1.14.2",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^20.14.0",
		"electron": "^31.0.0",
		"electron-builder": "^24.13.3",
		"typescript": "^5.5.2"
	},
	"build": {
		"appId": "com.codingmonster.app",
		"productName": "Coding Monster",
		"directories": {
			"output": "release"
		},
		"files": ["electron/**/*", "dist/**/*", "public/**/*", "game/**/*", ".env", "node_modules/**/*"],
		"win": {
			"target": "nsis"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		}
	}
}